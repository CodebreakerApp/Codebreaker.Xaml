<?xml version="1.0" encoding="utf-8"?>
<local:ShapeBase
    x:Class="CodeBreaker.WinUI.Views.Components.GamePage.Shapes.Star"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodeBreaker.WinUI.Views.Components.GamePage.Shapes"
    xmlns:converters="using:CodeBreaker.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Polygon
        Style="{StaticResource PegBaseStyle}"
        Width="{x:Bind Size}" Height="{x:Bind Size}"
        Points="50,0 55,15 70,15 60,25 65,40 50,30 35,40 40,25 30,15 45,15"
        Fill="{x:Bind ColorName, Mode=OneWay, Converter={StaticResource ColorConverter}}" />
</local:ShapeBase>
